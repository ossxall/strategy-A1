# Rutas relativas a la raíz del proyecto
BACKTEST_DATASET=dataset/binance/BTCUSDT/merged/BTCUSDT-1m.parquet
BACKTEST_OUTPUT_DIR=report/backtest_out

# Los parámetros de estrategia no definidos aquí usan los valores por defecto
# de strategy/config.py. Descomenta o añade variables BACKTEST_* para cambiarlos.
# Los nombres corresponden a las opciones del CLI: guiones -> guiones bajos.
# Ejemplos:
# BACKTEST_TIMEFRAME=30min
# BACKTEST_EMA_FAST=55
# BACKTEST_EMA_SLOW=200
# BACKTEST_RISK_PCT=0.01
# BACKTEST_ENTRY_ADX_FILTER=false
# BACKTEST_NO_PLOT=true
