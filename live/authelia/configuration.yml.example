server:
  # Serve the portal on the same HTTPS origin as the protected endpoints.
  address: 'tcp://:9091/auth'
  endpoints:
    authz:
      auth-request:
        implementation: 'AuthRequest'

log:
  level: 'info'

authentication_backend:
  file:
    path: '/config/users_database.yml'
  password_reset:
    disable: true

access_control:
  default_policy: 'deny'
  rules:
    # Replace with the exact public hostname used to access Nginx.
    - domain: 'lovelacers.com'
      policy: 'one_factor'

session:
  redis:
    host: 'redis'
    port: 6379
  cookies:
    - domain: 'lovelacers.com'
      authelia_url: 'https://lovelacers.com/auth/'
      default_redirection_url: 'https://lovelacers.com/'
      name: 'authelia_session'
      same_site: 'lax'
      expiration: '24h'
      inactivity: '24h'
      remember_me: -1

storage:
  local:
    path: '/data/db.sqlite3'

notifier:
  filesystem:
    filename: '/data/notification.txt'
