BOT_STRATEGY_PARTIAL_TP6_R=3.5
BOT_STRATEGY_PARTIAL_TP6_PCT=10.0
BOT_STRATEGY_PARTIAL_TP7_R=4.0
BOT_STRATEGY_PARTIAL_TP7_PCT=10.0
BOT_STRATEGY_TP3_EMA_SLOW_PENETRATION_PCT=1.75
BOT_STRATEGY_MOVE_STOP_TO_BREAKEVEN=true
BOT_STRATEGY_ADX_EXIT=true
BOT_STRATEGY_ADX_TIMEFRAME=1D
BOT_STRATEGY_ADX_DILEN=14
BOT_STRATEGY_ADX_ADXLEN=14
BOT_STRATEGY_ADX_KEY_LEVEL=23.0
