# El backtest no usa variables de entorno ni argumentos de línea de comandos.
#
# - Parámetros de la estrategia: defaults de strategy/config.py.
# - Ejecución (dataset, salida, gráfico, verbose): constantes al final de
#   strategy/strategy.py.
#
# Configuración del colector live/feed.py (todas las claves llevan FEED_).
FEED_SYMBOL=BTCUSDT
FEED_INTERVAL=1m
FEED_DB_PATH=data/feed.db
FEED_START_DATE=2026-08-01

FEED_REST_TIMEOUT_CONNECT=5
FEED_REST_TIMEOUT_READ=20
FEED_REST_PAGE_LIMIT=1500
FEED_REST_REPAIR_INTERVAL=60
FEED_GAP_SCAN_MINUTES=1440

FEED_WS_PING_INTERVAL=20
FEED_WS_PING_TIMEOUT=10
FEED_WS_WATCHDOG_SECONDS=90
FEED_MAX_BACKOFF_SECONDS=60
FEED_WS_MAX_RECOVERY_SECONDS=0
FEED_LOG_LEVEL=INFO

# Endpoint de diagnóstico: HTTP GET /health (alias /status).
FEED_STATUS_HOST=127.0.0.1
FEED_STATUS_PORT=8787
FEED_STATUS_DB_PROBE_INTERVAL=5
FEED_STATUS_DB_TIMEOUT=0.2
FEED_STATUS_REQUEST_TIMEOUT=1
FEED_STATUS_MAX_CLIENTS=8

# Endpoints JSON de salud del bot: /live/bot/health y alias /live/bot/status.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_MAX_CLIENTS=8
HTTP_REQUEST_TIMEOUT=1
HEALTH_DB_PROBE_INTERVAL=5
HEALTH_DB_PROBE_TIMEOUT=0.2
