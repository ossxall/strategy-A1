# Plantilla de nombres para secretos/datos privados. No pongas credenciales reales
# aquí: este archivo se versiona. Cópialo a .env.dev o .env.prod y protege la copia.

# Binance: claves separadas para trading y auditoría de solo lectura.
BOT_BINANCE_ACCOUNT_ID=
BOT_BINANCE_API_KEY=
BOT_BINANCE_API_SECRET=
BOT_BINANCE_PRODUCTION_AUDIT_API_KEY=
BOT_BINANCE_PRODUCTION_AUDIT_API_SECRET=

# Contacto de Let's Encrypt (dato personal).
LETSENCRYPT_EMAIL=

# Monitor privado: credenciales y endpoints que podrían revelar infraestructura.
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_PASSWORD=
MONITOR_FEED_URL=
MONITOR_BOT_URL=
MONITOR_EXECUTOR_URL=

# Solo si se habilita una contraseña propia para sqlite-web.
SQLITE_WEB_PASSWORD=
