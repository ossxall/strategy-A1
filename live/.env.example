# El backtest no usa variables de entorno ni argumentos de línea de comandos.
#
# - Parámetros de la estrategia: defaults de strategy/config.py.
# - Ejecución (dataset, salida, gráfico, verbose): constantes al final de
#   strategy/strategy.py.
#
# Configuración del colector live/feed.py (todas las claves llevan FEED_).
FEED_SYMBOL=BTCUSDT
FEED_INTERVAL=1m
FEED_DB_PATH=data/feed.db
FEED_START_DATE=2026-08-01

FEED_REST_TIMEOUT_CONNECT=5
FEED_REST_TIMEOUT_READ=20
FEED_REST_PAGE_LIMIT=1500
FEED_REST_REPAIR_INTERVAL=60
FEED_GAP_SCAN_MINUTES=1440

FEED_WS_PING_INTERVAL=20
FEED_WS_PING_TIMEOUT=10
FEED_WS_WATCHDOG_SECONDS=90
FEED_MAX_BACKOFF_SECONDS=60
FEED_WS_MAX_RECOVERY_SECONDS=0
FEED_LOG_LEVEL=INFO

# Endpoint de diagnóstico: HTTP GET /health (alias /status).
FEED_STATUS_HOST=127.0.0.1
FEED_STATUS_PORT=8787
FEED_STATUS_DB_PROBE_INTERVAL=5
FEED_STATUS_DB_TIMEOUT=0.2
FEED_STATUS_REQUEST_TIMEOUT=1
FEED_STATUS_MAX_CLIENTS=8

# Configuración del bot (todas las claves llevan BOT_).
# Endpoints JSON de salud: /live/bot/health y alias /live/bot/status.
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=8080
BOT_HTTP_MAX_CLIENTS=8
BOT_HTTP_REQUEST_TIMEOUT=1
BOT_HEALTH_DB_PROBE_INTERVAL=5
BOT_HEALTH_DB_PROBE_TIMEOUT=0.2

# Perfil de estrategia para una cuenta de referencia de 100 USDT.
BOT_STRATEGY_INITIAL_CAPITAL=100
BOT_STRATEGY_RISK_PCT=0.01
BOT_STRATEGY_MAX_LEVERAGE=10
BOT_STRATEGY_STOP_LOSS_PCT=0.01

# Worker de USDⓈ-M Futures. No envía órdenes si BOT_BINANCE_TRADING_ENABLED=false.
# Para empezar, usar exclusivamente testnet; producción requiere dos opt-ins.
# BOT_EXECUTOR_TEST_MODE=true envía órdenes de prueba repetidas; requiere
# BOT_BINANCE_TRADING_ENABLED=true y, en producción,
# BOT_BINANCE_ALLOW_LIVE_TRADING=true.
BOT_EXECUTOR_TEST_MODE=false
BOT_SYMBOL=BTCUSDT
BOT_SIGNAL_DB=data/signal.db
BOT_BINANCE_TRADING_ENABLED=false
BOT_BINANCE_ENVIRONMENT=testnet
BOT_BINANCE_ALLOW_LIVE_TRADING=false
BOT_BINANCE_ACCOUNT_ID=binance-testnet
BOT_BINANCE_API_KEY=
BOT_BINANCE_API_SECRET=
BOT_BINANCE_MAX_LEVERAGE=10
BOT_BINANCE_SET_LEVERAGE=true
# Los topes de riesgo/exposición pueden reducir el tamaño por debajo de 10x.
BOT_BINANCE_MAX_EQUITY_FRACTION=0.95
BOT_BINANCE_MAX_RISK_PCT=0.03
BOT_EXECUTOR_POLL_SECONDS=1
BOT_EXECUTOR_LEASE_SECONDS=30
BOT_EXECUTOR_MAX_ENTRY_AGE_SECONDS=90
BOT_EXECUTOR_INITIAL_BACKFILL_SECONDS=90
BOT_EXECUTOR_ACCOUNT_POLL_SECONDS=15
BOT_EXECUTOR_HEARTBEAT=data/executor.heartbeat

# Opciones del proceso bot que normalmente aporta docker-compose.yml.
# Compose puede sobrescribir estas rutas y BOT_LIVE_ONLY.
BOT_BACKTEST_REPORT_DIR=bot/data/backtest_out
BOT_DB_PATH=data/feed.db
BOT_HEARTBEAT=data/bot1.heartbeat
BOT_INTERVAL=1m
BOT_LIVE_ONLY=true
BOT_LIVE_SINCE=
BOT_LOG_LEVEL=INFO
BOT_POLL_SECONDS=30
BOT_RUN_ONCE=false

# Umbrales del healthcheck.
BOT_HEALTHCHECK_MAX_AGE=180
BOT_EXECUTOR_ACCOUNT_HEALTH_MAX_AGE=60
BOT_EXECUTOR_HEALTHCHECK_MAX_AGE=60

# Opciones de estrategia restantes; valores por defecto de strategy/config.py.
BOT_STRATEGY_EMA_FAST=55
BOT_STRATEGY_EMA_SLOW=200
BOT_STRATEGY_TIMEFRAME=30min
BOT_STRATEGY_ALLOW_LONG=true
BOT_STRATEGY_ALLOW_SHORT=true
BOT_STRATEGY_CONFIRM_BARS=4
BOT_STRATEGY_ENTRY_ADX=true
BOT_STRATEGY_ENTRY_ADX_LEN=14
BOT_STRATEGY_ENTRY_ADX_MIN=20.0
BOT_STRATEGY_ENTRY_ADX_TIMEFRAME=30min
BOT_STRATEGY_ENTRY_ATR=true
BOT_STRATEGY_ENTRY_ATR_LEN=14
BOT_STRATEGY_ENTRY_ATR_LOOKBACK=50
BOT_STRATEGY_ENTRY_ATR_MIN_RATIO=0.5
BOT_STRATEGY_ENTRY_ATR_MAX_RATIO=2.5
