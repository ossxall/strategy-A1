BOT_STRATEGY_ENTRY_ER_RISK_SLOPE=1.0
BOT_STRATEGY_ENTRY_ER_RISK_MIN=0.5
BOT_STRATEGY_ENTRY_ER_RISK_MAX=1.25
BOT_STRATEGY_COMMISSION_BPS=0.0
BOT_STRATEGY_SLIPPAGE_BPS=0.0
BOT_STRATEGY_PARTIAL_TP=true
BOT_STRATEGY_PARTIAL_TP_R=1.0
BOT_STRATEGY_PARTIAL_TP_PCT=10.0
BOT_STRATEGY_PARTIAL_TP2_R=1.5
BOT_STRATEGY_PARTIAL_TP2_PCT=10.0
BOT_STRATEGY_PARTIAL_TP3_R=2.0
BOT_STRATEGY_PARTIAL_TP3_PCT=10.0
BOT_STRATEGY_PARTIAL_TP4_R=2.5
BOT_STRATEGY_PARTIAL_TP4_PCT=10.0
