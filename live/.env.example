# El backtest no usa variables de entorno ni argumentos de línea de comandos.
#
# - Parámetros de la estrategia: defaults de strategy/config.py.
# - Ejecución (dataset, salida, gráfico, verbose): constantes al final de
#   strategy/strategy.py.
#
# Configuración del colector live/feed.py (todas las claves llevan FEED_).
FEED_SYMBOL=BTCUSDT
FEED_INTERVAL=1m
FEED_DB_PATH=data/feed.db
FEED_START_DATE=2026-08-01

FEED_REST_TIMEOUT_CONNECT=5
FEED_REST_TIMEOUT_READ=20
FEED_REST_PAGE_LIMIT=1500
FEED_REST_REPAIR_INTERVAL=60
FEED_GAP_SCAN_MINUTES=1440

FEED_WS_PING_INTERVAL=20
FEED_WS_PING_TIMEOUT=10
FEED_WS_WATCHDOG_SECONDS=90
FEED_MAX_BACKOFF_SECONDS=60
FEED_WS_MAX_RECOVERY_SECONDS=0
FEED_LOG_LEVEL=INFO

# Endpoint de diagnóstico: HTTP GET /health (alias /status).
FEED_STATUS_HOST=127.0.0.1
FEED_STATUS_PORT=8787
FEED_STATUS_DB_PROBE_INTERVAL=5
FEED_STATUS_DB_TIMEOUT=0.2
FEED_STATUS_REQUEST_TIMEOUT=1
FEED_STATUS_MAX_CLIENTS=8

# Endpoints JSON de salud del bot: /live/bot/health y alias /live/bot/status.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_MAX_CLIENTS=8
HTTP_REQUEST_TIMEOUT=1
HEALTH_DB_PROBE_INTERVAL=5
HEALTH_DB_PROBE_TIMEOUT=0.2

# Perfil de estrategia para una cuenta de referencia de 100 USDT.
STRATEGY_INITIAL_CAPITAL=100
STRATEGY_RISK_PCT=0.01
STRATEGY_MAX_LEVERAGE=10
STRATEGY_STOP_LOSS_PCT=0.01

# Worker de USDⓈ-M Futures. No envía órdenes si BINANCE_TRADING_ENABLED=false.
# Para empezar, usar exclusivamente testnet; producción requiere dos opt-ins.
# EXECUTOR_TEST_MODE=true envía órdenes de prueba repetidas; requiere
# BINANCE_TRADING_ENABLED=true y, en producción, BINANCE_ALLOW_LIVE_TRADING=true.
EXECUTOR_TEST_MODE=false
SYMBOL=BTCUSDT
SIGNAL_DB=data/signal.db
BINANCE_TRADING_ENABLED=false
BINANCE_ENVIRONMENT=testnet
BINANCE_ALLOW_LIVE_TRADING=false
BINANCE_ACCOUNT_ID=binance-testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MAX_LEVERAGE=10
BINANCE_SET_LEVERAGE=true
# Los topes de riesgo/exposición pueden reducir el tamaño por debajo de 10x.
BINANCE_MAX_EQUITY_FRACTION=0.95
BINANCE_MAX_RISK_PCT=0.03
EXECUTOR_POLL_SECONDS=1
EXECUTOR_LEASE_SECONDS=30
EXECUTOR_MAX_ENTRY_AGE_SECONDS=90
EXECUTOR_INITIAL_BACKFILL_SECONDS=90
EXECUTOR_ACCOUNT_POLL_SECONDS=15
EXECUTOR_HEARTBEAT=/data/executor.heartbeat
