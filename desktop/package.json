{
  "name": "desktop",
  "version": "1.0.0",
  "description": "La ventana usa `WebContentsView` de Electron para mostrar cada sistema; no usa `iframe`. Las pestañas se definen en `config.json` y no se pueden cerrar desde la interfaz.",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.strategy-a1.desktop",
    "productName": "Strategy A1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "fonts/InterVariable.woff2",
      "fonts/LICENSE.txt",
      "config.json",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "lucide": "^1.73.0"
  }
}
